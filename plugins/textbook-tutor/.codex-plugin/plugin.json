    "displayName": "\u6559\u6750\u79c1\u6559",
    "shortDescription": "\u901a\u8bfb\u5907\u8bfe\uff0c\u9010\u7ae0\u542f\u53d1\uff0c\u8bb0\u5f55\u8bfe\u5802\u8981\u70b9\u4e0e\u9519\u9898\u3002",
    "longDescription": "\u6e29\u8fea\u98ce\u683c\u7684\u6559\u6750\u79c1\u6559\uff1a\u5148\u901a\u8bfb\u5907\u8bfe\u3001\u6574\u7406\u5168\u4e66\u4e0e\u7ae0\u8282\u4efb\u52a1\uff0c\u518d\u6309\u5b66\u751f\u5b9e\u9645\u7406\u89e3\u9010\u70b9\u6559\u5b66\u3002\u9996\u6b21\u7b54\u9519\u5148\u63d0\u793a\uff0c\u4ecd\u9519\u518d\u8bb2\u89e3\uff1b\u72ec\u7acb\u638c\u63e1\u5904\u7b80\u8bb2\u5e76\u63d0\u9ad8\u95ee\u9898\u4ef7\u503c\uff0c\u56f0\u96be\u5904\u62c6\u5c0f\u8865\u8bb2\u3002\u901a\u8fc7\u6559\u6750\u539f\u56fe\u3001\u60c5\u5883\u9009\u62e9\u3001\u5b9a\u5411\u590d\u4e60\u548c\u7ae0\u672b\u7efc\u5408\u6311\u6218\u5efa\u7acb\u7406\u89e3\uff0c\u6bcf\u95e8\u8bfe\u4f7f\u7528\u4e00\u4e2a\u6301\u7eed\u66f4\u65b0\u7684 Obsidian \u7b14\u8bb0\uff0c\u8bb0\u5f55\u6765\u6e90\u3001\u8fdb\u5ea6\u3001\u9519\u7b54\u4e0e\u5b66\u4e60\u8bc1\u636e\u3002",
    "developerName": "Cyksei",
    "category": "Productivity",
    "capabilities": [],
    "defaultPrompt": "\u7528\u6559\u6750\u79c1\u6559\u5e26\u6211\u5b66\u4e60\uff1a\u5148\u786e\u8ba4\u672c\u8bfe\u7a0b Lessons \u8def\u5f84\uff0c\u4fdd\u5b58\u6559\u6750\u5e76\u521b\u5efa\u4e2d\u6587\u547d\u540d\u7684\u5355\u4e00\u8bfe\u7a0b\u7b14\u8bb0\uff0c\u901a\u8bfb\u6574\u7406\u540e\u9010\u7ae0\u82cf\u683c\u62c9\u5e95\u5f0f\u6559\u5b66\uff0c\u6301\u7eed\u66f4\u65b0\u7b14\u8bb0\u548c\u9519\u9898\u3002",
